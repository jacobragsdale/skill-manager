{
  "$defs": {
    "ManifestInstall": {
      "additionalProperties": false,
      "properties": {
        "destination": { "minLength": 1, "type": "string" },
        "id": { "maxLength": 64, "minLength": 1, "pattern": "^[a-z0-9](?:[a-z0-9]|-(?=[a-z0-9])){0,63}$", "type": "string" },
        "source": { "minLength": 1, "type": "string" }
      },
      "required": ["id", "source", "destination"],
      "type": "object"
    },
    "ManifestSource": {
      "additionalProperties": false,
      "properties": {
        "description": { "maxLength": 1024, "minLength": 1, "type": "string" },
        "id": { "maxLength": 16, "minLength": 2, "pattern": "^[a-z](?:[a-z0-9]|-(?=[a-z0-9])){1,15}$", "type": "string" },
        "name": { "maxLength": 120, "minLength": 1, "type": "string" }
      },
      "required": ["id", "name", "description"],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "installs": { "items": { "$ref": "#/$defs/ManifestInstall" }, "minItems": 1, "type": "array" },
    "source": { "$ref": "#/$defs/ManifestSource" },
    "version": { "maximum": 1, "minimum": 1, "type": "integer" }
  },
  "required": ["version", "source", "installs"],
  "title": "SourceManifest",
  "type": "object"
}
